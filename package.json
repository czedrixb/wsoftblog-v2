    "seed:supabase": "node --env-file=.env.supabase --import tsx src/seed/index.ts",
    "migrate:supabase": "node --env-file=.env.supabase ./node_modules/payload/bin.js migrate",
    "migrate:supabase:status": "node --env-file=.env.supabase ./node_modules/payload/bin.js migrate:status"
