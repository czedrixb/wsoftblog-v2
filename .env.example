# Postgres connection string. Local dev: matches docker-compose.yml.
# Production: a single env var, so moving to AWS RDS later is a one-line change.
DATABASE_URI=postgres://wsoftblog:wsoftblog@localhost:5432/wsoftblog

# Used to sign Payload's auth cookies/JWTs. Generate a real value for every
# environment — never reuse this placeholder.
PAYLOAD_SECRET=changeme-generate-a-real-secret

# Public URL of this app (used for admin links, media URLs in emails, etc).
# CRITICAL: this must be the browser-facing origin EXACTLY — scheme, host
# spelling (localhost vs 127.0.0.1) and port — because Payload derives its
# CSRF origin allowlist from it. If it doesn't match the URL the admin is
# actually opened at, every admin save/publish fails with 403.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Where uploaded media is written. VM deploy only — this MUST live outside
# the deploy directory (APP_PATH), or uploads get wiped by every redeploy.
# Ignored entirely once S3_BUCKET is set (Vercel/Supabase deploy, WOS-324):
# the s3Storage plugin disables local storage for the media collection.
MEDIA_DIR=media

NODE_ENV=development

# --- Seed script only (optional overrides, see src/seed/index.ts) ---
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_EDITOR_EMAIL=
# SEED_EDITOR_PASSWORD=

# --- E2E only ---
# E2E_BASE_URL=

# --- Vercel + Supabase deploy only (WOS-324) ---
# Setting S3_BUCKET enables @payloadcms/storage-s3 in src/payload.config.ts.
# Values come from Supabase Dashboard -> Storage -> Settings -> S3 Connection
# (endpoint + region) and S3 Access Keys (credentials). See README.md for the
# full runbook.
# S3_BUCKET=media
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=<project-region>
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Session-mode Supabase pooler string (port 5432), used only for the
# `migrate` step at Vercel build time. Runtime DATABASE_URI should be the
# transaction-mode pooler (port 6543) — see README.md.
# DATABASE_URI_SESSION=

# Kill-switch preventing a dev-mode local shell from pushing schema when
# pointed at a remote database (e.g. to seed Supabase). See README.md.
# PAYLOAD_DISABLE_PUSH=true
